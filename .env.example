# ─── PostgreSQL ───────────────────────────────────────────────────────────────
# Password for the greyhook_mes database user.
POSTGRES_PASSWORD=changeme

# ─── Auth ─────────────────────────────────────────────────────────────────────
# Random high-entropy string used to sign JWT tokens.
# Generate: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production
CORS_ORIGINS=http://localhost:3000

# ─── LLM provider ─────────────────────────────────────────────────────────────
# Which LLM to use for AI investigations. Options: claude, openai
LLM_PROVIDER=claude

# Anthropic API key (required when LLM_PROVIDER=claude)
ANTHROPIC_API_KEY=sk-ant-api03-...

# OpenAI API key (required when LLM_PROVIDER=openai)
OPENAI_API_KEY=

# ─── Observability ────────────────────────────────────────────────────────────
# Grafana admin password (used only when the monitoring profile is active)
GRAFANA_PASSWORD=changeme

# OpenTelemetry collector endpoint (optional; leave empty to disable)
OTEL_EXPORTER_OTLP_ENDPOINT=

# ─── Edge / simulator identifiers ─────────────────────────────────────────────
# UUIDs identifying the pilot organization and factory.
# Must match seed data in the database.
ORG_ID=00000000-0000-0000-0000-000000000001
FACTORY_ID=00000000-0000-0000-0000-000000000001
GATEWAY_ID=edge-gateway-01

# ─── Simulator ────────────────────────────────────────────────────────────────
# Org and factory UUIDs used by the factory simulator (must match ORG_ID/FACTORY_ID above).
DEMO_ORG_ID=00000000-0000-0000-0000-000000000001
DEMO_FACTORY_ID=00000000-0000-0000-0000-000000000001

# Simulation speed multiplier. 1.0 = real time; 4.0 = 4× faster.
SIM_SPEED_FACTOR=4.0
