[
  {
    "id": "tab-mqtt-kafka",
    "type": "tab",
    "label": "MQTT → MES Events",
    "disabled": false,
    "info": "Bridges MQTT machine events to GreyHook MES REST API"
  },
  {
    "id": "mqtt-in-1",
    "type": "mqtt in",
    "z": "tab-mqtt-kafka",
    "name": "Machine Telemetry",
    "topic": "machines/+/telemetry",
    "qos": "1",
    "datatype": "json",
    "broker": "mqtt-broker-1",
    "nl": false,
    "rap": false,
    "rh": 0,
    "x": 120,
    "y": 100,
    "wires": [["parse-telemetry"]]
  },
  {
    "id": "parse-telemetry",
    "type": "function",
    "z": "tab-mqtt-kafka",
    "name": "Parse & Enrich",
    "func": "const parts = msg.topic.split('/');\nconst machineId = parts[1];\nmsg.payload = {\n  machine_id: machineId,\n  timestamp: new Date().toISOString(),\n  ...msg.payload\n};\nreturn msg;",
    "outputs": 1,
    "x": 340,
    "y": 100,
    "wires": [["post-to-mes"]]
  },
  {
    "id": "post-to-mes",
    "type": "http request",
    "z": "tab-mqtt-kafka",
    "name": "POST → MES API",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://backend:8000/api/v1/machines/{{{payload.machine_id}}}/events",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "bearer",
    "senderr": false,
    "x": 560,
    "y": 100,
    "wires": [["debug-response"]]
  },
  {
    "id": "debug-response",
    "type": "debug",
    "z": "tab-mqtt-kafka",
    "name": "Response",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "payload",
    "x": 760,
    "y": 100,
    "wires": []
  },
  {
    "id": "mqtt-broker-1",
    "type": "mqtt-broker",
    "name": "Mosquitto",
    "broker": "mosquitto",
    "port": "1883",
    "clientid": "nodered-mes",
    "usetls": false,
    "protocolVersion": "4",
    "keepalive": "60",
    "cleansession": true,
    "autoConnect": true,
    "birthTopic": "",
    "birthQos": "0",
    "birthPayload": "",
    "closeTopic": "",
    "closeQos": "0",
    "closePayload": "",
    "willTopic": "",
    "willQos": "0",
    "willPayload": ""
  },
  {
    "id": "tab-erp-webhook",
    "type": "tab",
    "label": "ERP Webhook → Work Orders",
    "disabled": false,
    "info": "Receives ERP work order events and creates/updates MES production orders"
  },
  {
    "id": "http-in-erp",
    "type": "http in",
    "z": "tab-erp-webhook",
    "name": "ERP Webhook",
    "url": "/webhook/erp/workorder",
    "method": "post",
    "upload": false,
    "swaggerDoc": "",
    "x": 120,
    "y": 100,
    "wires": [["validate-erp-payload"]]
  },
  {
    "id": "validate-erp-payload",
    "type": "function",
    "z": "tab-erp-webhook",
    "name": "Map ERP → MES Schema",
    "func": "const erp = msg.payload;\nif (!erp.order_number || !erp.product_code || !erp.planned_qty) {\n  msg.statusCode = 400;\n  msg.payload = { error: 'Missing required fields: order_number, product_code, planned_qty' };\n  node.send([null, msg]);\n  return;\n}\nmsg.payload = {\n  order_number: erp.order_number,\n  product_code: erp.product_code,\n  line_id: erp.line_id || null,\n  planned_qty: erp.planned_qty,\n  planned_start: erp.start_date || new Date().toISOString(),\n  planned_end: erp.end_date || null,\n  status: 'scheduled',\n  bom_ref: erp.bom_id || null,\n  notes: erp.notes || null\n};\nreturn [msg, null];",
    "outputs": 2,
    "x": 360,
    "y": 100,
    "wires": [["post-production-order"], ["http-response-error"]]
  },
  {
    "id": "post-production-order",
    "type": "http request",
    "z": "tab-erp-webhook",
    "name": "POST → MES Production Orders",
    "method": "POST",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://backend:8000/api/v1/production/orders",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "bearer",
    "senderr": false,
    "x": 620,
    "y": 80,
    "wires": [["http-response-success"]]
  },
  {
    "id": "http-response-success",
    "type": "http response",
    "z": "tab-erp-webhook",
    "name": "201 Created",
    "statusCode": "201",
    "headers": { "content-type": "application/json" },
    "x": 850,
    "y": 80,
    "wires": []
  },
  {
    "id": "http-response-error",
    "type": "http response",
    "z": "tab-erp-webhook",
    "name": "400 Bad Request",
    "statusCode": "400",
    "headers": { "content-type": "application/json" },
    "x": 860,
    "y": 120,
    "wires": []
  },
  {
    "id": "tab-oee-alert",
    "type": "tab",
    "label": "OEE Alert → Notification",
    "disabled": false,
    "info": "Polls OEE endpoint and sends alert when OEE drops below threshold"
  },
  {
    "id": "poll-oee-trigger",
    "type": "inject",
    "z": "tab-oee-alert",
    "name": "Every 5 min",
    "props": [{ "p": "payload" }, { "p": "topic", "vt": "str" }],
    "repeat": "300",
    "crontab": "",
    "once": false,
    "onceDelay": "10",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 120,
    "y": 100,
    "wires": [["fetch-oee"]]
  },
  {
    "id": "fetch-oee",
    "type": "http request",
    "z": "tab-oee-alert",
    "name": "GET OEE Summary",
    "method": "GET",
    "ret": "obj",
    "paytoqs": "ignore",
    "url": "http://backend:8000/api/v1/oee/summary?granularity=hour&limit=1",
    "tls": "",
    "persist": false,
    "proxy": "",
    "authType": "bearer",
    "senderr": false,
    "x": 300,
    "y": 100,
    "wires": [["check-oee-threshold"]]
  },
  {
    "id": "check-oee-threshold",
    "type": "function",
    "z": "tab-oee-alert",
    "name": "Check < 65% OEE",
    "func": "const OEE_THRESHOLD = 0.65;\nconst items = msg.payload.items || [];\nconst low = items.filter(r => r.oee < OEE_THRESHOLD);\nif (low.length === 0) return null;\nmsg.payload = {\n  alert: 'OEE below threshold',\n  threshold: OEE_THRESHOLD,\n  machines: low.map(r => ({ machine_id: r.machine_id, oee: r.oee }))\n};\nreturn msg;",
    "outputs": 1,
    "x": 530,
    "y": 100,
    "wires": [["log-alert"]]
  },
  {
    "id": "log-alert",
    "type": "debug",
    "z": "tab-oee-alert",
    "name": "OEE Alert",
    "active": true,
    "tosidebar": true,
    "console": true,
    "tostatus": true,
    "complete": "payload",
    "x": 740,
    "y": 100,
    "wires": []
  }
]
